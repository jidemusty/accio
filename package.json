{
  "name": "accio-orm",
  "version": "0.1.0",
  "description": "The summoning charm for Postgres - A lightweight TypeScript ORM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node examples/basic-usage.ts",
    "dev-test": "npx tsx src/examples/test-querybuilder.ts",
    "dev-test-1": "npx ts-node tsconfig-paths/register examples/test-decorators",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm run test:run"
  },
  "keywords": [
    "orm",
    "postgres",
    "postgresql",
    "typescript",
    "database",
    "sql",
    "data-mapper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidemusty/accio.git"
  },
  "bugs": {
    "url": "https://github.com/jidemusty/accio/issues"
  },
  "homepage": "https://github.com/jidemusty/accio#readme",
  "author": "Mustapha Adubiagbe",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "pg": "^8.16.3",
    "prettier": "^3.7.4",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2"
  }
}
